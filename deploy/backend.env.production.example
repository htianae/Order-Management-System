NODE_ENV=production
PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=https://example.com

DATABASE_URL=postgresql://order_user:change_this_password@127.0.0.1:5432/order_system?schema=public

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

UPLOAD_DIR=uploads
FILE_BASE_URL=https://example.com/uploads

DASHSCOPE_API_KEY=
AI_PROVIDER=bailian
AI_MODEL=qwen3.7-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_AGENT_MAX_TOOL_ITERATIONS=5
AI_AGENT_TIMEOUT_MS=30000
AI_AGENT_DELAYED_STATUS_DAYS=14
AI_AGENT_DELAYED_PURCHASE_TO_SHIP_DAYS=7
AI_AGENT_DELAYED_SHIP_TO_PAYMENT_DAYS=30
